rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TEST MODE: anyone with the project's API key can read and write every
    // document until the date below. Replace with auth-based rules before
    // putting real data in this database.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 6);
    }
  }
}
