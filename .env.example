# Firebase web SDK config. Copy to .env.local and fill in from the Firebase
# console: Project settings -> General -> Your apps -> SDK setup and configuration.
# These values are shipped to the browser and are not secrets; Firestore rules
# and Auth settings are what actually protect the project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
